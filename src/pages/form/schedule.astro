---
import HeroText from '~/components/widgets/HeroText.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: "Let's Talk",
};
---

<Layout metadata={metadata}>
  <HeroText
    title="Thanks!"
  >
    <Fragment slot="content">
      <p>Your information has been submitted successfully.</p>
    </Fragment>
  </HeroText>
  <CallToAction 
    title="Schedule a call with us"
    subtitle='Get answers to technical questions from our engineers. <br>Learn about pricing and the ordering process.'
    actions={[
      {
        text: "Schedule a Call Now",
        href: "https://calendar.app.google/Xn85unnCoM4hHzwU7",
        target: "_blank",
        icon: "tabler:book"
      },
    ]}
  />
</Layout>
